# Copy to .env (or set in your host's dashboard). All optional for local dev.

# --- Payments (x402, USDC on Base) ---
PAY_TO=                      # your wallet address; leave empty = paid routes are free (dev mode)
X402_NETWORK=base-sepolia    # base-sepolia (testnet) or base (mainnet)
CDP_API_KEY_ID=              # mainnet only — from portal.cdp.coinbase.com
CDP_API_KEY_SECRET=
FREE_CALLS_PER_DAY=25        # per-IP free calls on paid routes
PRICE_PROFIT=$0.002
PRICE_COMPARE=$0.005

# --- Server ---
PORT=3000
PUBLIC_URL=                  # https://your-domain, used in llms.txt/openapi links
ADMIN_TOKEN=                 # protects POST /admin/overrides/:coin
MCP_FREE_CALLS_PER_DAY=50

# --- Data ---
COINGECKO_API_KEY=           # optional demo key
DEFAULT_KWH=0.10
NETWORK_TTL_MS=60000
PRICE_TTL_MS=60000
